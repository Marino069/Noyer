DJANGO_SECRET_KEY=change-moi
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DATABASE_URL=mysql://adm_noyer:mot-de-passe@127.0.0.1:3306/noyer
FRONT_URL=http://localhost:3000
REDIS_URL=redis://redis:6379/0
# Domaine du cookie du panier (ex. .noyer.ch en production, vide en local)
PANIER_COOKIE_DOMAIN=
# Montants : TVA en centièmes de pour cent (810 = 8,1 %), frais de livraison en centimes
TVA_TAUX_CENTIEMES=810
FRAIS_LIVRAISON_CENTIMES=0
# SMTP (identifiants à fournir en production uniquement)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Noyer <commandes@noyer.ch>
