# URL de base de l'API REST Django (voir docs/api.md)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# true : le front tourne sur les mocks MSW (mocks/), sans back
NEXT_PUBLIC_API_MOCKS=false
# true : vente en ligne directe (indicateur panier affiché) ; false : site vitrine (brief §08)
NEXT_PUBLIC_SHOP_ENABLED=false
# URL publique du site : canonical et hreflang doivent être absolus (SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret partagé avec le back : le webhook de publication l'envoie dans l'en-tête x-webhook-secret
REVALIDATE_SECRET=
# Secret du mode aperçu (brouillons) : /api/apercu?secret=...&slug=...
PREVIEW_SECRET=
